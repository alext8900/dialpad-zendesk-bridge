# IMPORTANT: this file is loaded by docker compose (env_file), which does NOT
# strip inline "# comments" after a value. Keep every comment on its OWN line —
# never put "# ..." after a VALUE, or the comment becomes part of the value.

# ---- Zendesk (required) ----------------------------------------------------
# ZENDESK_SUBDOMAIN is the <x> in <x>.zendesk.com
ZENDESK_SUBDOMAIN=your-subdomain
# an agent email (token auth uses email/token)
ZENDESK_EMAIL=it-bot@yourco.com
ZENDESK_API_TOKEN=your-zendesk-api-token
# Optional. Leave BLANK if "Support" is your default group (unassigned tickets
# land there automatically). Only set to a numeric group id to force a specific
# non-default group.
ZENDESK_GROUP_ID=

# ---- Dialpad webhook verification (recommended) ----------------------------
# Long random string. Set the SAME value here and when running setup_dialpad.py.
# If blank, the bridge accepts unsigned JSON (fine for a first test, not prod).
DIALPAD_WEBHOOK_SECRET=

# ---- Dialpad API (needed to attach the voicemail audio FILE) ---------------
# API token with the 'recordings'/'recordings_export' scope. The bridge uses it
# to download the voicemail audio and re-upload it to Zendesk as a real file
# attachment (like the native integration). Without it, voicemails get a link.
DIALPAD_API_TOKEN=your-dialpad-api-token
# false = just drop the voicemail_link instead of attaching the audio file
ATTACH_VOICEMAIL_AUDIO=true

# ---- Bridge behavior -------------------------------------------------------
# inbound | outbound | both
TICKET_ON=inbound
# true = only ticket internal calls (avoids double-ticketing external calls the
# native integration already handles)
INTERNAL_ONLY=true
# comma-list of contact.type values treated as internal (e.g. user,room)
INTERNAL_CONTACT_TYPES=user
# minimum agent TALK seconds for an answered call to make a ticket (0 = any real
# talk; talk_time excludes IVR/queue time, so menu-disconnects are filtered anyway)
MIN_TALK_SECONDS=0
# SQLite path (volume-mounted in compose)
STATE_DB=/data/state.db
# set true to log the full Dialpad event payload (diagnostics); leave false in prod
DEBUG_PAYLOAD=false

# ---- Cloudflare Tunnel (publishes the bridge at a stable public URL) -------
# Token for the named tunnel you create in the Cloudflare Zero Trust dashboard.
# Its public hostname (e.g. dialpad.bpiteam.com) should point at http://bridge:8080.
TUNNEL_TOKEN=

# ---- Needed when running setup_dialpad.py (one-time registration) -----------
# DIALPAD_API_TOKEN above is reused. PUBLIC_WEBHOOK_URL = your tunnel hostname.
PUBLIC_WEBHOOK_URL=https://dialpad.bpiteam.com/dialpad/webhook
# IT_TARGETS=department:111,callcenter:222,callcenter:333,callcenter:444
