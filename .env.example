# ---- Zendesk (required) ----------------------------------------------------
ZENDESK_SUBDOMAIN=your-subdomain        # the <x> in <x>.zendesk.com
ZENDESK_EMAIL=it-bot@yourco.com         # an agent email (token auth uses email/token)
ZENDESK_API_TOKEN=your-zendesk-api-token
ZENDESK_GROUP_ID=                        # optional: route auto-tickets to this group id

# ---- Dialpad webhook verification (recommended) ----------------------------
# Long random string. Set the SAME value here and when running setup_dialpad.py.
# If blank, the bridge accepts unsigned JSON (fine for a first test, not prod).
DIALPAD_WEBHOOK_SECRET=

# ---- Bridge behavior -------------------------------------------------------
TICKET_ON=inbound                        # inbound | outbound | both
INTERNAL_ONLY=true                       # true = only ticket internal calls (avoids
                                         # double-ticketing external calls the native
                                         # integration already handles)
INTERNAL_CONTACT_TYPES=user              # comma-list of contact.type values treated as
                                         # internal (e.g. "user,room")
STATE_DB=/data/state.db                  # SQLite path (volume-mounted in compose)

# ---- Only needed when running setup_dialpad.py (one-time registration) ------
# Can be passed inline instead (see README). Uncomment to keep them here.
# DIALPAD_API_TOKEN=your-dialpad-admin-api-key
# PUBLIC_WEBHOOK_URL=https://your-host/dialpad/webhook
# IT_TARGET_TYPE=callcenter              # office | department | callcenter | user | room
# IT_TARGET_ID=12345                     # id of your IT help-desk queue
